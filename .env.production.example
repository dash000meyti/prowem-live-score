# Public endpoint
PUBLIC_URL=http://178.239.147.50
PUBLIC_HOST=178.239.147.50
PUBLIC_SCHEME=http
PUBLIC_REVERB_PORT=80
HTTP_PORT=80
AUTH_COOKIE_SECURE=false

# Release identifier used as the local image tag
IMAGE_TAG=latest

# Generate once with: docker compose run --rm api php artisan key:generate --show
APP_KEY=
LOG_LEVEL=warning
PUBLIC_API_DOCS=true

# Internal database credentials
DB_DATABASE=event_care
DB_USERNAME=event_care
DB_PASSWORD=replace-with-a-random-password

# Reverb credentials (must match between Laravel, Reverb and the web build)
REVERB_APP_ID=event-care
REVERB_APP_KEY=event-care-key
REVERB_APP_SECRET=replace-with-a-random-secret
